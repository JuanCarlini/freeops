# Variables de entorno de FREEOPS (configurarlas en Vercel, no en el cliente).
# Este archivo documenta las variables; NUNCA poner valores reales acá.

# Webhook de n8n que recibe cada visita como POST JSON
# { path, referrer, country, ts }. Si está vacía, /api/track no guarda nada.
N8N_TRACK_WEBHOOK_URL=

# Secreto compartido opcional: /api/track lo envía en el header x-track-secret
# para que el workflow de n8n descarte requests que no vengan del sitio.
N8N_TRACK_SECRET=
